YOUTUBE_API_KEY=

# Optional locally (falls back to a local SQLite file in data/app.db when unset).
# Required on Vercel (or any host without a persistent filesystem) — see README for setup.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Protects /api/cron/refresh-channels from unauthenticated calls. Required on Vercel
# (auto-sent by Vercel Cron as a Bearer header once this env var is set there).
CRON_SECRET=

# Auth.js (Google ile giriş). AUTH_SECRET: `npx auth secret` ya da
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` ile üretin.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console > APIs & Services > Credentials
# üzerinden bir "OAuth client ID" (Web application) oluşturup buraya girin. Authorized redirect
# URI olarak <site-url>/api/auth/callback/google eklemeniz gerekir.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# İlk deploy sonrası mevcut (sahipsiz) kanal/kategori/konsept verisini bu e-postaya sahip
# kullanıcıya otomatik bağlar. Sadece prod'da, bir kereliğine gereklidir.
OWNER_EMAIL=
