YOUTUBE_API_KEY=

# Optional locally (falls back to a local SQLite file in data/app.db when unset).
# Required on Vercel (or any host without a persistent filesystem) — see README for setup.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Protects /api/cron/refresh-channels from unauthenticated calls. Required on Vercel
# (auto-sent by Vercel Cron as a Bearer header once this env var is set there).
CRON_SECRET=

# Auth.js (Google ile giriş). AUTH_SECRET: `npx auth secret` ya da
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` ile üretin.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud Console > APIs & Services > Credentials
# üzerinden bir "OAuth client ID" (Web application) oluşturup buraya girin. Authorized redirect
# URI olarak <site-url>/api/auth/callback/google eklemeniz gerekir.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# İlk deploy sonrası mevcut (sahipsiz) kanal/kategori/konsept verisini bu e-postaya sahip
# kullanıcıya otomatik bağlar. Sadece prod'da, bir kereliğine gereklidir. Bu hesap ayrıca
# üyelik/deneme kısıtlamasından muaf tutulur (bkz. src/lib/access.ts).
OWNER_EMAIL=

# iyzico (ücretli üyelik / abonelik ödemeleri). Sandbox hesabı: https://sandbox-merchant.iyzipay.com/
# IYZICO_API_KEY / IYZICO_SECRET_KEY / IYZICO_MERCHANT_ID: iyzico Merchant Panel > Ayarlar > API
# Anahtarları'ndan alınır. IYZICO_BASE_URL boş bırakılırsa NODE_ENV'e göre otomatik seçilir
# (sandbox-api.iyzipay.com / api.iyzipay.com). Her plan (Standart/Pro/Ultra) için ayrı bir ürün +
# fiyat planı oluşturulur (bkz. scripts/setup-iyzico-plan.mjs, README > iyzico Kurulumu) ve
# referans kodu buraya girilir.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
IYZICO_BASE_URL=
IYZICO_PRICING_PLAN_REF_CODE_STANDART=
IYZICO_PRICING_PLAN_REF_CODE_PRO=
IYZICO_PRICING_PLAN_REF_CODE_ULTRA=

# NexLev (Ultra plan kanal analiz paneli). https://dashboard.nexlev.io — NexLev'in kendi Pro
# planı gerektirir. Anahtar alınıp buraya girilene kadar /analysis sayfası "yapılandırma
# aşamasında" mesajı gösterir.
NEXLEV_API_KEY=

# Anthropic API (kapak görseli + metin kalitesi puanlaması, /analysis sayfası).
# https://console.anthropic.com/settings/keys üzerinden alınır. Tanımlı değilse bu iki sütun
# "—" gösterir, diğer analiz verileri (yaş/ülke/RPM/kitle uyumu) etkilenmez.
ANTHROPIC_API_KEY=

# Yandex Haritalar (Dashboard > Ülkeye Göre Dağılım'da gerçek/zoomlanabilir harita).
# https://developer.tech.yandex.ru/ adresinden bir Yandex hesabıyla giriş yapıp "JavaScript API
# и HTTP Геокодер" (JavaScript API and HTTP Geocoder) için ücretsiz bir API anahtarı oluşturun.
# NEXT_PUBLIC_ ile başladığı için tarayıcıya gönderilir — bu normaldir, Yandex anahtarları API
# tarafında domain kısıtlamasıyla korunur, gizli tutulması gerekmez. Tanımlı değilse Dashboard
# otomatik olarak kendi çizdiği (SVG) dünya haritasına döner, sayfa bozulmaz.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
